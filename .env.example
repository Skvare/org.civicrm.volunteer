# CiviVolunteer PHPUnit suite — environment variables.
#
# Copy the values you need into your codebase's .env (or export them in your
# shell). Consumed by tools/run-phpunit.sh; the runner prints the values it
# resolved before starting PHPUnit. Environment variables always win over
# values defined in the .env file.

# --- Required ---------------------------------------------------------------
# MySQL account used for the disposable test database. It only needs CREATE
# on that database. Never point the suite at a real site database.

CIVIVOLUNTEER_TEST_DB_USER="dbuser"
CIVIVOLUNTEER_TEST_DB_PASSWORD="change-me"

# --- Optional: database location (defaults shown) ---------------------------

#CIVIVOLUNTEER_TEST_DB_HOST="127.0.0.1"
#CIVIVOLUNTEER_TEST_DB_PORT="3306"

# --- Optional: disposable database name -------------------------------------
# Must begin with civivolunteer_test or civivolunteer_phpunit. The suite drops
# and rebuilds this database on every run.

#CIVIVOLUNTEER_TEST_DB="civivolunteer_phpunit"

# --- Optional: seed dump ----------------------------------------------------
# Used once, when the disposable database is first created. Any bootable
# CiviCRM 6.16 schema works — the headless installer replaces all contents.
# Default: tests/phpunit/seed/civicrm-seed.sql inside this extension
# (gitignored; keep your dump out of version control). Generate one with:
#   mkdir -p tests/phpunit/seed
#   mysqldump -h 127.0.0.1 -P 3306 -u root -p <some_civicrm_db> \
#     > tests/phpunit/seed/civicrm-seed.sql

#CIVIVOLUNTEER_TEST_SEED=""

# --- Optional: integration with your codebase -------------------------------
# Path to the codebase's real civicrm.settings.php, which the test guard loads
# and then overrides with the test DSN. Default: discovered by searching
# upward from the working directory, then from the extension, across the
# standard Drupal (web/sites/default/, sites/default/), Backdrop, WordPress,
# Joomla 5+, and Standalone layouts. Set it when discovery cannot find it.

#CIVIVOLUNTEER_TEST_SITE_SETTINGS=""

# cv binary. Default: the codebase's own vendor/bin/cv, found above the
# working directory or the extension; `cv` on PATH is used only when no
# vendor/bin/cv exists. Prefer the codebase's copy — it is installed against
# this CiviCRM, while a global cv may target a different core release.

#CIVICRM_CV=""

# Env file the runner sources. Default: nearest .env above the working
# directory, then above the extension. Not required if the variables are
# already exported in your shell.

#CIVIVOLUNTEER_TEST_ENV_FILE=""

# --- Optional: tooling ------------------------------------------------------
# Explicit PHPUnit 9.6 binary or PHAR. Otherwise the runner uses phpunit9 on
# PATH or downloads the pinned 9.6.36 PHAR (sha256-verified) into tools/.cache/.

#PHPUNIT9_BIN=""
